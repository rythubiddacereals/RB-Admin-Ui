# Copy to .env for local development.
# The API base — during `npm run dev`, Vite's proxy in vite.config.ts
# already forwards /api → http://localhost:8081, so this can stay empty.
# For production builds, set to the Spring Boot host, e.g. https://admin.rythubidda.com
VITE_API_BASE_URL=

# Google Maps JavaScript API key (Places autocomplete in Delivery Centers).
# Same browser key the shop UI uses.
VITE_GOOGLE_MAPS_API_KEY=
